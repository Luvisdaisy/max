# 复制为 .env 后按需修改。不要把填了密钥的 .env 提交进仓库。

# 主推理后端：local、remote、modelscope、dashscope 或 openrouter。
# 模型、OpenAI 兼容根端点与能力统一在 src/max_gui/provider.py 中定义。
MAX_PROVIDER=local

# 云端密钥可同时保存；切换时只修改 MAX_PROVIDER。local / remote 不使用 API Key。
# 魔搭：https://modelscope.cn/my/myaccesstoken
# 百炼：https://bailian.console.aliyun.com/?tab=model#/api-key
# OpenRouter：https://openrouter.ai/settings/keys
MAX_MODELSCOPE_KEY=
MAX_DASHSCOPE_KEY=
MAX_OPENROUTER_KEY=

# 本机 vLLM 运行参数；只在 local 下执行 max-gui serve 时使用。
MAX_GUI_MAX_MODEL_LEN=8192
MAX_GUI_GPU_MEM=0.85
MAX_GUI_DTYPE=auto

# Agent / 图像 / 工具
MAX_GUI_MAX_ITERATIONS=20
MAX_GUI_MAX_IMAGE_EDGE=1536
MAX_GUI_MAX_IMAGE_BYTES=2000000
MAX_GUI_TOOL_TIMEOUT=30
MAX_GUI_WORKSPACE=

# OCR（独立本机服务，不跟 MAX_PROVIDER）
MAX_GUI_OCR_BASE_URL=http://127.0.0.1:8001/v1
MAX_GUI_OCR_START_TIMEOUT=180
MAX_GUI_OCR_TIMEOUT=120
MAX_GUI_OCR_GPU_MEM=0.20

# OmniParser 界面定位（仅支持本机 loopback 服务；worker 接收本地图片路径；权重默认 model/omniparserv2/）
MAX_GUI_OMNIPARSER_DIR=omniparserv2
MAX_GUI_OMNIPARSER_BASE_URL=http://127.0.0.1:8002
MAX_GUI_OMNIPARSER_START_TIMEOUT=180
MAX_GUI_OMNIPARSER_TIMEOUT=120
# MAX_GUI_OMNIPARSER_PYTHON=
# worker 使用该解释器，需已安装 ultralytics（默认即 vLLM 旁的 python）
