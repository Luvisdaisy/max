# 复制为 .env 后按需修改。不要把填了密钥的 .env 提交进仓库。

# 推理后端：local（本机 vLLM）或 modelscope（魔搭 API-Inference）
MAX_PROVIDER=local

# 仅 modelscope 必填：魔搭 Access Token（https://modelscope.cn/my/myaccesstoken）
MAX_PROVIDER_KEY=

# 模型名。local 用完整目录名（如 qwen3.5-4b）；modelscope 用魔搭 Model Id
# local 缺省 qwen3.5-4b；modelscope 缺省 Qwen/Qwen3.8-27B
MODEL_NAME=qwen3.5-4b

# 本地 vLLM（MAX_PROVIDER=local 时使用；modelscope 时忽略）
MAX_GUI_BASE_URL=http://127.0.0.1:8000/v1
MAX_GUI_MAX_MODEL_LEN=8192
MAX_GUI_GPU_MEM=0.85
MAX_GUI_DTYPE=auto

# Agent / 图像 / 工具
MAX_GUI_MAX_ITERATIONS=20
MAX_GUI_MAX_IMAGE_EDGE=1536
MAX_GUI_MAX_IMAGE_BYTES=2000000
MAX_GUI_TOOL_TIMEOUT=30
MAX_GUI_WORKSPACE=

# OCR（独立本机服务，不跟 MAX_PROVIDER）
MAX_GUI_OCR_BASE_URL=http://127.0.0.1:8001/v1
MAX_GUI_OCR_START_TIMEOUT=180
MAX_GUI_OCR_TIMEOUT=120
MAX_GUI_OCR_GPU_MEM=0.20
